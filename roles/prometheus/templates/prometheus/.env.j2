# Managed by Ansible. Local changes will be overwritten.
{% set prometheus_runtime_flags = prometheus_extra_flags
  + (['--storage.tsdb.retention.size=' ~ prometheus_retention_size] if prometheus_retention_size | length > 0 else [])
  + (['--web.external-url=' ~ prometheus_external_url] if prometheus_external_url | length > 0 else [])
  + (['--web.config.file=' ~ prometheus_container_config_dir ~ '/web-config.yml'] if prometheus_web_config | length > 0 or prometheus_basic_auth_users | length > 0 else []) %}
PROMETHEUS_IMAGE={{ prometheus_image | to_json }}
PROMETHEUS_CONTAINER_NAME={{ prometheus_container_name | to_json }}
PROMETHEUS_USER={{ prometheus_runtime_user | to_json }}
PROMETHEUS_RESTART_POLICY={{ prometheus_restart_policy | to_json }}
PROMETHEUS_WEB_LISTEN_ADDRESS={{ prometheus_web_listen_address | to_json }}
PROMETHEUS_DATA_DIR={{ prometheus_data_dir | to_json }}
PROMETHEUS_RETENTION_TIME={{ prometheus_retention_time | to_json }}
PROMETHEUS_STOP_GRACE_PERIOD={{ prometheus_stop_grace_period | to_json }}
PROMETHEUS_EXTRA_ARGS={{ prometheus_runtime_flags | map('quote') | join(' ') | to_json }}
PROMETHEUS_LOG_MAX_SIZE={{ prometheus_log_max_size | to_json }}
PROMETHEUS_LOG_MAX_FILES={{ prometheus_log_max_files | to_json }}
PROMETHEUS_HEALTHCHECK_INTERVAL={{ prometheus_healthcheck_interval | to_json }}
PROMETHEUS_HEALTHCHECK_TIMEOUT={{ prometheus_healthcheck_timeout | to_json }}
PROMETHEUS_HEALTHCHECK_RETRIES={{ prometheus_healthcheck_retries | string | to_json }}
PROMETHEUS_HEALTHCHECK_START_PERIOD={{ prometheus_healthcheck_start_period | to_json }}
