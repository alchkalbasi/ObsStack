# Managed by Ansible. Local changes will be overwritten.
{% for key, value in {
  'GRAFANA_TAG': grafana_tag,
  'RESTART_POLICY': grafana_restart_policy,
  'GRAFANA_CONTAINER_NAME': grafana_container_name,
  'PORT': grafana_port | string,
  'GRAFANA_NETWORK1': grafana_network1,
  'GRAFANA_NETWORK2': grafana_network2,
  'GRAFANA_USERNAME': grafana_username,
  'GRAFANA_PASSWORD': grafana_password
}.items() %}
{{ key }}={{ value | to_json(ensure_ascii=false) | replace('$', '$$') }}
{% endfor %}
