# Managed by Ansible. Local changes will be overwritten.
[Unit]
Description=Heplify HEP capture agent and Prometheus exporter
Documentation=https://github.com/sipcapture/heplify
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory={{ exporters_heplify_data_dir }}
ExecStart={{ exporters_heplify_binary_dest }} -config {{ exporters_heplify_config_path }}
Restart={{ exporters_heplify_restart_policy }}
RestartSec={{ exporters_heplify_restart_seconds }}s
LimitNOFILE=65536
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
