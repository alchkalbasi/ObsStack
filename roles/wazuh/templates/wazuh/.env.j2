# Managed by Ansible. Local changes will be overwritten.
{% for key, value in {
  'WAZUH_VERSION': wazuh_version,
  'WAZUH_CERTS_GENERATOR_TAG': wazuh_certs_generator_tag,
  'WAZUH_CERT_TOOL_VERSION': wazuh_version.split('.')[:2] | join('.'),
  'WAZUH_RESTART_POLICY': wazuh_restart_policy,
  'WAZUH_INDEXER_HEAP': wazuh_indexer_heap,
  'WAZUH_AGENT_LISTEN': wazuh_agent_listen,
  'WAZUH_ENROLLMENT_LISTEN': wazuh_enrollment_listen,
  'WAZUH_API_LISTEN': wazuh_api_listen,
  'WAZUH_INDEXER_LISTEN': wazuh_indexer_listen,
  'WAZUH_DASHBOARD_LISTEN': wazuh_dashboard_listen,
  'WAZUH_INDEXER_PASSWORD': wazuh_indexer_password,
  'WAZUH_DASHBOARD_PASSWORD': wazuh_dashboard_password,
  'WAZUH_API_PASSWORD': wazuh_api_password
}.items() %}
{{ key }}={{ value | string | to_json(ensure_ascii=false) | replace('$', '$$') }}
{% endfor %}
