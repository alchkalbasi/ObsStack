# Managed by Ansible. Local changes will be overwritten.
{% set alertmanager_runtime_flags = alertmanager_extra_flags
  + (['--web.external-url=' ~ alertmanager_external_url] if alertmanager_external_url | length > 0 else []) %}
{% set alertmanager_route_prefix = alertmanager_external_url | urlsplit('path') | regex_replace('/+$', '') %}
ALERTMANAGER_IMAGE={{ alertmanager_image | to_json }}
ALERTMANAGER_CONTAINER_NAME={{ alertmanager_container_name | to_json }}
ALERTMANAGER_USER={{ alertmanager_runtime_user | to_json }}
ALERTMANAGER_RESTART_POLICY={{ alertmanager_restart_policy | to_json }}
ALERTMANAGER_WEB_LISTEN_ADDRESS={{ alertmanager_web_listen_address | to_json }}
ALERTMANAGER_DATA_DIR={{ alertmanager_data_dir | to_json }}
ALERTMANAGER_DATA_RETENTION={{ alertmanager_data_retention | to_json }}
ALERTMANAGER_LOG_LEVEL={{ alertmanager_log_level | to_json }}
ALERTMANAGER_READY_PATH={{ (alertmanager_route_prefix ~ '/-/ready') | to_json }}
ALERTMANAGER_STOP_GRACE_PERIOD={{ alertmanager_stop_grace_period | to_json }}
ALERTMANAGER_EXTRA_ARGS={{ alertmanager_runtime_flags | map('quote') | join(' ') | to_json }}
ALERTMANAGER_LOG_MAX_SIZE={{ alertmanager_log_max_size | to_json }}
ALERTMANAGER_LOG_MAX_FILES={{ alertmanager_log_max_files | string | to_json }}
ALERTMANAGER_HEALTHCHECK_INTERVAL={{ alertmanager_healthcheck_interval | to_json }}
ALERTMANAGER_HEALTHCHECK_TIMEOUT={{ alertmanager_healthcheck_timeout | to_json }}
ALERTMANAGER_HEALTHCHECK_RETRIES={{ alertmanager_healthcheck_retries | string | to_json }}
ALERTMANAGER_HEALTHCHECK_START_PERIOD={{ alertmanager_healthcheck_start_period | to_json }}
